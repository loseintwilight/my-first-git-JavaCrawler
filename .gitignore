build/
dist/
*.egg-info/
*.whl
# 缓存/日志
.pytest_cache/
.coverage
htmlcov/
*.log
# Jupyter Notebook
.ipynb_checkpoints
# 系统临时文件
*.swp
.DS_Store

# ======================== C/C++项目专用忽略规则 ========================
# 编译产物
*.o
*.obj
*.out
*.exe
*.dll
*.so
*.dylib
# 编译中间文件
*.s
*.ii
*.i

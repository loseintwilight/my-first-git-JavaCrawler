# ======================== 前端项目通用忽略规则（你的原有内容） ========================
# 依赖目录
node_modules/
# 打包输出目录
dist/
build/
# 环境变量文件
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# 缓存文件
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# 编辑器配置
.vscode/
*.sublime-*

# ======================== Java项目专用忽略规则 ========================
# IDEA配置文件
.idea/
*.iml
*.ipr
*.iws
# Eclipse配置文件
.classpath
.project
.settings/
bin/
# 编译输出目录
target/
out/
